---
import Base from "../layouts/Base.astro";
import IngestForm from "../components/IngestForm.tsx";
---

<Base title="Ingest · Recall" heading="Ingest" current="ingest">
  <h1>Choose phrases from a video</h1>
  <p class="muted">
    Select the Spanish you want from the full transcript. Preview and trim its
    native audio, then explicitly add only the clips you approve.
  </p>
  <IngestForm client:load />
</Base>
