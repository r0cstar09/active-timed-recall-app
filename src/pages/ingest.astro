---
import Base from "../layouts/Base.astro";
import IngestForm from "../components/IngestForm.tsx";
---

<Base title="Ingest · Recall" heading="Ingest" current="ingest">
  <header class="page-intro">
    <span class="eyebrow">Real life is your textbook</span>
    <h1>Watch it. Keep it. Say it.</h1>
    <p>Bring a video you love. Pick phrases from its transcript, trim the original audio, and add only the Spanish you want to learn.</p>
  </header>
  <IngestForm client:load />
</Base>
