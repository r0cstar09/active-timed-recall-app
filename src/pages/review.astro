---
import Base from "../layouts/Base.astro";
import CorrectionReview from "../components/CorrectionReview.tsx";
---

<Base title="Review · Recall" heading="Review" current="review">
  <header class="page-intro">
    <span class="eyebrow">Make the next attempt count</span>
    <h1>A clearer way to say it.</h1>
    <p>Compare what you said with the target phrase, hear the difference, and give it another go.</p>
  </header>
  <div class="stack" style="margin-bottom: 16px;">
    <a class="btn btn-primary btn-block" href="/session?mode=misses">Practice misses workout</a>
    <p class="small faint" style="margin: 0;">Fresh Misses attempts update FSRS; passing removes the card from this queue.</p>
  </div>
  <CorrectionReview client:load />
</Base>
